# Chrome Web Store publishing credentials (for chrome-webstore-upload-cli).
# Copy to .env and fill in — or set the same names as GitHub repo secrets for CI.
#
# The EXTENSION_ID is public (it's in the store URL) and already committed in
# .github/workflows/publish.yml. The three OAuth values below ARE secret.
#
# How to generate them (one time):
#   1. Google Cloud Console -> enable the "Chrome Web Store API".
#   2. Create an OAuth 2.0 Client ID (type: Desktop app) -> CLIENT_ID + CLIENT_SECRET.
#   3. Use the OAuth Playground (or the CLI's docs) to mint a REFRESH_TOKEN
#      for scope https://www.googleapis.com/auth/chromewebstore.
# See: https://github.com/fregante/chrome-webstore-upload-cli#authentication

EXTENSION_ID=mhojjemphcgfbjikablofecafbbkjafp
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Safari / App Store build (tools/build-safari.mjs).
#
# APPLE_TEAM_ID  — your 10-char Apple Developer Team ID (developer.apple.com →
#   Membership details). Injected into the regenerated Xcode project so archives
#   sign automatically with no manual Xcode step. One-time value.
# APPLE_BUILD    — optional. Overrides the auto UTC-timestamp build number; leave
#   unset to let each build get a fresh, monotonically-increasing number.
APPLE_TEAM_ID=
APPLE_BUILD=

# Apple → TestFlight release (tools/release-apple.mjs; `npm run release:apple`
# for both platforms, or `release:ios` / `release:mac` for one).
#
# App Store Connect API key — lets the archive upload non-interactively (no
# Apple-ID password). Create at App Store Connect → Users and Access →
# Integrations → App Store Connect API (role: App Manager). Download the .p8
# ONCE into secrets/ (git-ignored) and record the two ids below.
#
# ASC_KEY_ID     — the API Key ID (10 chars).
# ASC_ISSUER_ID  — the Issuer ID (UUID, shown above the keys list).
# ASC_KEY_PATH   — optional. Path to AuthKey_<id>.p8; defaults to the first
#                  secrets/AuthKey_*.p8 it finds.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
